<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Banner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top Title Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_flight"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:id="@+id/container_trip_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_trip_destination"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/trip_destination_default"
                                android:textColor="#D0E8F5"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@string/edit_trip_title"
                                android:src="@drawable/ic_edit"
                                app:tint="#D0E8F5" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SOS Emergency Broadcast Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sos_broadcast"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#DC2626"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="@string/sos_button"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_sos"
                        app:iconSize="16dp"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <!-- Quick Emergency Direct Action Toolbar Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Emergency Count Badge -->
                    <LinearLayout
                        android:id="@+id/container_emergency_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_search_box"
                        android:backgroundTint="#20FFFFFF"
                        android:gravity="center"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_shield_emergency" />

                        <TextView
                            android:id="@+id/tv_header_emergency_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="0 Emergency" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Medical Quick Call -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_call_medical"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:backgroundTint="#30FFFFFF"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:text="@string/btn_ambulance"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_ambulance"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />

                            <!-- Police Quick Call -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_call_police"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:backgroundTint="#30FFFFFF"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:text="@string/btn_police"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_police"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />

                            <!-- Safety Check-In SMS -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_safe_checkin"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:backgroundTint="#4000E676"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:text="@string/btn_safe_checkin"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_safe_checkin"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_white"
            android:elevation="4dp"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_all_contacts" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_emergency_contacts" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Main Content Area Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ALL CONTACTS SECTION -->
            <LinearLayout
                android:id="@+id/layout_all_contacts_section"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Search Box -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/search_hint"
                            android:src="@drawable/ic_search" />

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:autofillHints="name"
                            android:background="@null"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="textPersonName"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btn_clear_search"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/clear_search"
                            android:src="@drawable/ic_clear"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ListView for All Contacts -->
                <ListView
                    android:id="@+id/lv_all_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingBottom="12dp" />

                <!-- Empty All Contacts View -->
                <LinearLayout
                    android:id="@+id/layout_empty_all_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_contacts"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_empty_all_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/empty_all_contacts"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_sample_contacts"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/add_sample_contacts"
                        android:textColor="@color/primary"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary" />
                </LinearLayout>

            </LinearLayout>

            <!-- EMERGENCY CONTACTS SECTION -->
            <LinearLayout
                android:id="@+id/layout_emergency_contacts_section"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Emergency Subheader & Share Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/emergency_red_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_shield_emergency" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/emergency_subheader"
                        android:textColor="#C62828"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_emergency_list"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/share_emergency_list"
                        android:textColor="#C62828"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#C62828"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Category Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cat_all"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/chip_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cat_family"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_family" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cat_medical"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_medical" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cat_hotel"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_hotel" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cat_buddy"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_buddy" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- ListView for Emergency Contacts -->
                <ListView
                    android:id="@+id/lv_emergency_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <!-- Empty Emergency View -->
                <LinearLayout
                    android:id="@+id/layout_empty_emergency"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_shield_emergency" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/empty_emergency_contacts"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PERMISSION REQUIRED OVERLAY -->
            <LinearLayout
                android:id="@+id/layout_permission_required"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_light"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@string/permission_required_title"
                    android:src="@drawable/ic_warning_permission" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/permission_required_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/permission_required_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_grant_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="@string/grant_permission_btn"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_load_demo_contacts_perm"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/try_demo_contacts"
                    android:textColor="@color/primary" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>